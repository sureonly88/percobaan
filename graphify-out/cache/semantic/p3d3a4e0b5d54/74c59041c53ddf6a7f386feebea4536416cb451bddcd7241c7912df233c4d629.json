des", "label": "Print Modes (ps | copy | direct)", "file_type": "concept", "source_file": "print-bridge/README.md", "source_location": "L100-L102", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "ps uses PowerShell + WinSpooler API for modern USB printers; copy uses 'copy /b file LPT3:' or a shared printer path for printers mapped via net use."}, {"id": "print_bridge_readme_raw_ascii_output", "label": "RAW ASCII + CRLF + Form Feed Output (no ESC bold)", "file_type": "rationale", "source_file": "print-bridge/README.md", "source_location": "L116-L117", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "The Epson ESC/P 9pin V4 Class Driver on USB001 holds certain jobs sent via WinSpooler RAW or containing unsafe control/non-ASCII characters, so the LX-310 uses copy mode to share \\\\localhost\\EPSONLX with plain RAW ASCII."}, {"id": "print_bridge_readme_one_bill_one_page", "label": "1 Tagihan = 1 Lembar (pageLines continuous form)", "file_type": "rationale", "source_file": "print-bridge/README.md", "source_location": "L119-L133", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "9.5x11/3 perforated paper requires pageLines 22; 66 would make each bill consume 3 pieces. Bridge sends ESC 2, ESC C n, ESC O per job; Windows print processor must be WinPrint+RAW so no extra form feed is added."}, {"id": "print_bridge_readme_line_drop_priority", "label": "Decorative Line Dropping When Overflowing", "file_type": "rationale", "source_file": "print-bridge/README.md", "source_location": "L130", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "When content exceeds pageLines - topMargin, formatter drops decorative lines (reprint note, subtitle, separators, scan instructions) so the receipt fits one piece; billing data, amounts, token and URL are never dropped."}, {"id": "print_bridge_readme_http_endpoints", "label": "Print Bridge HTTP Endpoints (/ping, /printers, /config, /template, /preview, /test-print, /print)", "file_type": "concept", "source_file": "print-bridge/README.md", "source_location": "L137-L147", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "print_bridge_readme_cors_whitelist", "label": "CORS Whitelist localhost / 127.0.0.1", "file_type": "concept", "source_file": "print-bridge/README.md", "source_location": "L160", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "print_bridge_readme_zero_dependency", "label": "Zero External Dependencies (Node built-ins only)", "file_type": "rationale", "source_file": "print-bridge/README.md", "source_location": "L17", "source_url": null, "captured_at": null, "author": null, "contributor": null, "rationale": "Uses only http, child_process, fs so no npm install is needed on cashier PCs."}, {"id": "print_bridge_readme_node_18_requirement", "label": "Node.js >= 18 Requirement (print-bridge)", "file_type": "concept", "source_file": "print-bridge/README.md", "source_location": "L6", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "print_bridge_readme_update_procedure", "label": "Bridge Update Procedure (stop, git pull, restart)", "file_type": "concept", "source_file": "print-bridge/README.md", "source_location": "L164-L170", "source_url": null, "captured_at": null, "author": null, "contributor": null}, {"id": "print_bridge_readme_pengaturan_printer_ui", "label": "Pengaturan > Printer UI", "file_type": "concept", "source_file": "print-bridge/README.md", "source_location": "L87", "source_url": null, "captured_at": null, "author": null, "contributor": null}], "edges": [{"source": "print_bridge_readme", "target": "print_bridge_server", "relation": "references", "confidence": "EXTRACTED", "confidence_score": 1.0, "source_file": "print-bridge/README.md", "source_location": "L27", "weight": 1.0}, {"source": "print_bridge_readm
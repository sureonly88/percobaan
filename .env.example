DB_HOST=127.0.0.1
DB_USER=root
DB_PASSWORD=
DB_NAME=pedami_payment
DB_PORT=3306

NEXTAUTH_SECRET=your-secret-here-change-me
NEXTAUTH_URL=http://localhost:3000
MOBILE_JWT_SECRET=your-mobile-jwt-secret-here-change-me
CRON_SECRET=your-cron-secret-here-change-me

# Set true only when app is behind a trusted reverse proxy that sanitizes X-Forwarded-For/X-Real-IP.
TRUST_PROXY_HEADERS=false

# Retry stuck online invoice provider processing after this many minutes.
PAYMENT_LINK_PROVIDER_RETRY_MINUTES=15
MULTIPAY_PENDING_RETRY_MINUTES=15

# Dangerous database admin UI. Keep false/empty in production unless explicitly needed.
ENABLE_DB_MANAGE=false
MANAGE_DB_PASS=change-this-only-if-db-manage-enabled

# PDAM API
PDAM_PROTOCOL=https
PDAM_IPADDR=your-pdam-host
PDAM_PORT=8730
PDAM_CLIENT_ID=your-client-id
PDAM_PASSWORD=your-password

# Setup (set to true only for initial admin creation, then remove)
# ALLOW_SETUP=true
